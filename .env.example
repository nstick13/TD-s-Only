# Copy this file to .env.local and fill in real values from your Supabase
# project's Settings > API page. Never commit .env.local.

# Supabase project URL (Settings > API > Project URL). Safe to expose to the
# browser — used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Settings > API > Project API keys > anon
# public). Safe to expose to the browser — Row Level Security policies are
# what actually protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key (Settings > API > Project API keys >
# service_role). SERVER-ONLY. Bypasses Row Level Security entirely — never
# prefix with NEXT_PUBLIC_, never import into client components, never log
# it. Used by trusted server code and Supabase Edge Functions (ESPN sync
# jobs) that must write across all managers' data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
